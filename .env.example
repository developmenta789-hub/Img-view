# Copy to .env (never commit .env). In GitHub Codespaces use "Codespaces secrets" instead of a file.
PORT=3000
DB_PATH=./data/nst.sqlite
FIREBASE_PROJECT_ID=noryvexal-784c8
# Owner's Firebase uid(s), comma separated. Only these can approve deposits / change payment details.
ADMIN_UIDS=
# Web origins allowed to call the API from a browser (Arena website). Android apps do not need this.
CORS_ORIGINS=
# Deposit limits (rupees = coins). DAILY_LIMIT 0 = unlimited. The owner can change on/off + daily limit later via the API.
DEPOSIT_MIN=10
DEPOSIT_MAX=10000
DEPOSIT_DAILY_LIMIT=0
DEPOSIT_MAX_PENDING=5
# Day boundary for the daily limit, minutes from UTC (India = 330)
TZ_OFFSET_MIN=330
# Only if the public address is NOT a GitHub Codespace (then publish-url uses this)
PUBLIC_URL=

# --- Firestore (Task 1) ---
# Firebase Console > Project settings > Service accounts > Generate new private key. Then make base64 (one line):
#   base64 -w0 key.json      (Termux: base64 -w0 key.json)
# Paste the result into FIREBASE_SERVICE_ACCOUNT_B64 as a Render Environment Variable. NEVER commit the key or put it in the zip.
FIREBASE_SERVICE_ACCOUNT_B64=

# Withdrawals: how many pending requests one player may have
WITHDRAW_MAX_PENDING=3

# Web push (FCM) for the Arena website. Free. PUSH_ENABLED=0 switches the "match started" push off.
# ARENA_URL = the public address of the Arena website (https, used for the click link and icon of the push).
PUSH_ENABLED=1
ARENA_URL=https://developmenta789-hub.github.io/Noryvexal-Arena/
