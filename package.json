{
  "name": "nst-server",
  "version": "0.2.0",
  "private": true,
  "description": "NST Server: Node.js backend for Noryvexal (Firestore via Firebase Admin SDK)",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test \"test/*.test.js\"",
    "publish-url": "node scripts/publish-url.js",
    "codespace": "node scripts/publish-url.js --push && node src/index.js"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0"
  }
}
